# Domain Configuration
DOMAIN_NAME=yourdomain.com
SUBDOMAIN=n8n
N8N_HOST=n8n.yourdomain.com

# n8n Basic Auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here

# Timezone
GENERIC_TIMEZONE=America/New_York

# Meta Ads MCP Configuration
META_APP_ID=your_meta_app_id_here
META_ACCESS_TOKEN=your_meta_access_token_optional

# Database Configuration (optional - comment out to use SQLite)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=your_secure_db_password_here

# Security (generate strong passwords)
# You can generate secure passwords with: openssl rand -base64 32