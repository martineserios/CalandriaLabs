    {
      "parameters": {
        "jsCode": "// Process and format the campaign insights data\nconst insights = $input.all();\nconst processedData = [];\n\nfor (const item of insights) {\n  if (item.json && item.json.data) {\n    for (const campaign of item.json.data) {\n      processedData.push({\n        campaign_id: campaign.campaign_id,\n        campaign_name: campaign.campaign_name || 'Unknown',\n        impressions: parseInt(campaign.impressions) || 0,\n        clicks: parseInt(campaign.clicks) || 0,\n        spend: parseFloat(campaign.spend) || 0,\n        ctr: parseFloat(campaign.ctr) || 0,\n        cpm: parseFloat(campaign.cpm) || 0,\n        cpc: parseFloat(campaign.cpc) || 0,\n        date_processed: new Date().toISOString()\n      });\n    }\n  }\n}\n\nreturn processedData.map(data => ({ json: data }));"
      },
